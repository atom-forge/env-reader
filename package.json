	"description": "Type-safe environment variable reader for TypeScript",
	"keywords": [
		"env",
		"environment",
		"config",
		"typescript"
	],
	"author": "Gergely Laborci",
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"main": "dist/index.js",
