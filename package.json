{
	"name": "@atom-forge/env-reader",
	"version": "0.1.6",
	"description": "Type-safe environment variable reader for TypeScript",
	"keywords": [
		"env",
		"environment",
		"config",
		"typescript"
	],
	"author": {
		"name": "Gergely Laborci",
		"url": "https://github.com/laborci"
	},
	"license": "MIT",
	"homepage": "https://github.com/atom-forge/env-reader#readme",
	"bugs": {
		"url": "https://github.com/atom-forge/env-reader/issues"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atom-forge/env-reader.git"
	},
	"engines": {
		"node": ">=18"
	},
	"files": [
		"dist",
		"docs",
		"README-AI.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit -p tsconfig.test.json",
		"test": "bun test",
		"check": "bun run typecheck && bun run test",
		"prepublishOnly": "bun run build",
		"pub-check": "bun run scripts/pub-check.ts",
		"pub": "bun run scripts/pub.ts"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"@types/node": "^25.3.1",
		"typescript": "^5.0.0"
	}
}
